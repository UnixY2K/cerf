cerf_args = []
cerf_link = []
cerf_deps = [
	nlohmannjson_dep,
]

if host_machine.system() != 'windows'
	cerf_deps += libwin32coded_dep
endif

if slirp_dep.found()
	cerf_srcs += [
		'net/slirp_backend.cpp',
		'net/slirp_classify_frame.cpp',
		'net/slirp_dns_aaaa_strip.cpp',
		'net/slirp_icmp_echo.cpp',
		'net/slirp_ipv6_probe.cpp',
		'net/slirp_poll_shim.cpp',
	]
	cerf_deps += slirp_dep
endif

# required to fill some windows functions like messagebox
if host_machine.system() == 'darwin'
  cerf_deps += dependency('appleframeworks', modules: ['CoreFoundation'])
endif

executable(
	'cerf',
	cerf_srcs,
	include_directories: [cerf_incl],
	cpp_args: cerf_args,
	dependencies: cerf_deps,
)